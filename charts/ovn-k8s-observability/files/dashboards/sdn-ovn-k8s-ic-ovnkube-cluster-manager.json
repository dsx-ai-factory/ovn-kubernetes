      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "7ae56dbe010ad8befe6861dcfd23e42b",
  "title": "OVN K8S IC / Ovnkube Cluster Manager",
  "tags": [
    "SDN"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "schemaVersion": 41,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Cluster Manager",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "table",
      "targets": [
        {
          "expr": "ovnkube_clustermanager_build_info{cluster=\"$cluster\", namespace=\"ovn-kubernetes\"}",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Build Info",
      "description": "ovnkube-cluster-manager build info.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "version",
                "branch",
                "revision",
                "goversion",
                "pod"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
              "branch": 1,
              "goversion": 3,
              "pod": 4,
              "revision": 2,
              "version": 0
            },
            "renameByName": {
              "branch": "Branch",
              "goversion": "Go",
              "revision": "Revision",
              "version": "Version"
            }
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Branch": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Go": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Revision": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Version": {
                "aggregations": [],
                "operation": "groupby"
              },
              "pod": {
                "aggregations": [
                  "count"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {},
            "renameByName": {
              "pod (count)": "Pods"
            }
          }
        }
      ]
    },
    {
      "type": "state-timeline",
      "targets": [
        {
          "expr": "ovnkube_clustermanager_leader{cluster=\"$cluster\", namespace=\"ovn-kubernetes\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Leader Status",
      "description": "Identifies whether the instance of ovnkube-cluster-manager is a leader(1) or not(0).",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.9,
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": ""
        },
        "perPage": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FOLLOWER",
                  "color": "orange",
                  "index": 1
                },
                "1": {
                  "text": "LEADER",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 70
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{cluster=\"$cluster\", namespace=\"ovn-kubernetes\", pod=~\"$pod\",container=\"ovnkube-cluster-manager\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "description": "CPU usage of container ovnkube-cluster-manager.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "interval": "120s",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "drawStyle": "line",
            "thresholdsStyle": {
              "mode": "off"
            },
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{cluster=\"$cluster\", namespace=\"ovn-kubernetes\", pod=~\"$pod\",container=\"ovnkube-cluster-manager\"}) / 1024^3",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "description": "Working set memory usage of container ovnkube-cluster-manager.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "interval": "120s",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "custom": {
            "drawStyle": "line",
            "thresholdsStyle": {
              "mode": "off"
            },
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "targets": [
        {
          "expr": "max by (network_name) (ovnkube_clustermanager_allocated_v4_host_subnets{cluster=\"$cluster\", namespace=\"ovn-kubernetes\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "max by (network_name) (ovnkube_clustermanager_num_v4_host_subnets{cluster=\"$cluster\", namespace=\"ovn-kubernetes\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "B"
        },
        {
          "expr": "max by (network_name) (ovnkube_clustermanager_allocated_v6_host_subnets{cluster=\"$cluster\", namespace=\"ovn-kubernetes\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "C"
        },
        {
          "expr": "max by (network_name) (ovnkube_clustermanager_num_v6_host_subnets{cluster=\"$cluster\", namespace=\"ovn-kubernetes\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "D"
        }
      ],
      "title": "Host Subnets",
      "description": "The number of host subnets allocated and total number of host subnets.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "network_name",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "network_name": 0
