  "templating": {
    "list": [
      {
        "type": "query",
        "name": "cluster",
        "label": "Cluster",
        "skipUrlSync": false,
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"ovnkube-node\"}, cluster)",
          "refId": "prometheus-cluster-Variable-Query"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "multi": false,
        "allowCustomValue": true,
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "allValue": "\"\"",
        "regex": "",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "pod",
        "label": "Pod",
        "skipUrlSync": false,
        "description": "A list of ovnkube-control-plane Pods.",
        "query": "label_values(kube_pod_info{cluster=\"$cluster\", namespace=\"ovn-kubernetes\", created_by_name=~\"ovnkube-control-plane-.*\"},pod)",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {}
