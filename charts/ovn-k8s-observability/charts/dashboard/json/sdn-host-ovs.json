          "expr": "sum by (bridge,  version) (label_replace(ovs_vswitchd_interface_info{`}}{{ .Values.clusterLabel.label }}{{`=\"$cluster\"}, \"version\", \"$1\", \"firmware_version\", \"(.*)\"))",
          "instant": true,
