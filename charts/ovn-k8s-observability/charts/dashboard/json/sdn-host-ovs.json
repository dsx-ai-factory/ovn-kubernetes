            "reduce": {
              "include": [
                "Value #B",
                "Value #A"
              ],
              "reducer": "sum"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "Value #B": true
            },
            "include": {
              "names": [
                "bridge",
                "version",
                "Interface"
              ]
            },
            "includeByName": {},
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
