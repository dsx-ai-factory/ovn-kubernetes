  "uid": "b246596647bea0b5a3fa81f15322b436",
  "title": "OVN K8S IC / Northbound DB",
  "tags": [
    "SDN"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "schemaVersion": 41,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Northbound DB Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "table",
      "targets": [
        {
          "expr": "ovn_db_build_info{k8s_cluster_name=~\"$cluster\",namespace=\"ovn-kubernetes\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Build Info",
      "description": "A metric with a constant '1' value labeled by ovsdb-server version and NB and SB schema version.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "version",
                "nb_schema_version",
                "pod"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
              "nb_schema_version": 1,
              "pod": 2,
              "version": 0
            },
            "renameByName": {
              "nb_schema_version": "NB Schema Version",
              "version": "OVS Version"
            }
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "NB Schema Version": {
                "aggregations": [],
                "operation": "groupby"
              },
              "OVS Version": {
                "aggregations": [],
                "operation": "groupby"
              },
              "pod": {
                "aggregations": [
                  "count"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {},
            "renameByName": {
              "pod (count)": "Pods"
            }
          }
        }
      ]
    },
    {
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_ready{container=\"nb-ovsdb\",k8s_cluster_name=~\"$cluster\",namespace=\"ovn-kubernetes\"})",
          "legendFormat": "READY",
          "refId": "A"
        },
        {
          "expr": "count(kube_pod_container_status_ready{container=\"nb-ovsdb\",k8s_cluster_name=~\"$cluster\",namespace=\"ovn-kubernetes\"}) - sum(kube_pod_container_status_ready{container=\"nb-ovsdb\",k8s_cluster_name=~\"$cluster\",namespace=\"ovn-kubernetes\"})",
          "legendFormat": "NOT READY",
          "refId": "B"
        }
      ],
      "title": "Container nb-ovsdb Readiness",
      "description": "The summary of ready and not ready nb-ovsdb containers.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "options": {
        "displayMode": "lcd",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "NOT READY"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "heatmap",
      "targets": [
        {
          "expr": "ovn_db_db_size_bytes{db_name=\"OVN_Northbound\",k8s_cluster_name=~\"$cluster\",namespace=\"ovn-kubernetes\"}",
          "format": "heatmap",
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "DB Size Overview",
      "description": "The size of the database file associated with the OVN DB component.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "interval": "120s",
      "options": {
        "calculate": true,
        "cellGap": 1,
        "color": {
          "exponent": 0.5,
          "fill": "dark-orange",
          "mode": "scheme",
          "reverse": false,
          "scale": "exponential",
          "scheme": "Oranges",
          "steps": 64
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
