# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
obs-as-code/
output/
tmp/
bin/
*venv/
__pycache__/
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
.cursor/
# other files
*.tgz
Chart.lock
.helmignore
.helmdocsignore
.gitlab
.gitlab-ci.yml
README.md.gotmpl
Makefile
tests/
