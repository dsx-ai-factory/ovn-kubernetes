    plural: ipreservations
    shortNames:
    - ipreserve
    singular: ipreservation
  scope: Namespaced
  versions:
  - additionalPrinterColumns:
    - jsonPath: .spec.networkAttachmentName
      name: NetworkName
      type: string
    - jsonPath: .spec.ipfamily
