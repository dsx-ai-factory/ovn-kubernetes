apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  labels:
    prometheus: k8s
    shardable: "true"
    role: alert-rules
  name: ovnkube-rules-shardable
  namespace: ovn-kubernetes
spec:
  groups:
  - name: general.rules
    rules:
    - alert: OvnKubePodRestarts
      expr: |
        rate(kube_pod_container_status_restarts_total{namespace="ovn-kubernetes", container=~"ovnkube.*"}[15m]) * 60 * 5 > 0
      for: 30m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/960e_tDMk/k8s-control-panel-kube-agent
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} {{ $labels.container}} is restarting 
         {{ printf "%.2f" $value }} times / 5 minutes.        
                
    - alert: K8sNodeWithoutOvnKubeAgentRunning
      expr: |
        kube_node_info unless on(node)
        (kube_pod_info{namespace="ovn-kubernetes", pod=~"ovnkube-node.*"}) > 0
      for: 10m
      labels:
       severity: minor
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/960e_tDMk/k8s-control-panel-kube-agent
      annotations:
       message: |
         All K8s nodes should be running OVN K8s Agent pods, 
         but OVN K8s Agent pod is not running on {{ $labels.node }} node.  

    - alert: K8sCriticalNodeWithoutOvnKubeRunning
      expr: |
        (kube_pod_status_phase{namespace="ovn-kubernetes", phase="Running", pod=~"ovnkube-node-.*|ovn-host-.*"} * on(pod) group_left(node)
         kube_pod_info{namespace="ovn-kubernetes", pod=~"ovnkube-node-.*|ovn-host-.*", node=~".*k8s-supervisor-.*|.*nid-core-.*|.*k8s-ovn-.*|.*-cs-.*|.*-ss-.*"}) == 0
      for: 20m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/960e_tDMk/k8s-control-panel-kube-agent
      annotations:
       message: |
         OvnKube/Host K8s pod {{ $labels.pod }} is in not Running on critical infrastructure node {{ $labels.node }} for longer than 20min

    - alert: K8sCriticalNodeWithoutOvnKubeReady
      expr: |
        (kube_pod_status_ready{namespace="ovn-kubernetes", condition="true", pod=~"ovnkube-node-.*|ovn-host-.*"} * on(pod) group_left(node)
         kube_pod_info{namespace="ovn-kubernetes", pod=~"ovnkube-node-.*|ovn-host-.*", node=~".*k8s-supervisor-.*|.*nid-core-.*|.*k8s-ovn-.*|.*-cs-.*|.*-ss-.*"}) == 0
      for: 20m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/960e_tDMk/k8s-control-panel-kube-agent
      annotations:
       message: |
         OvnKube/Host K8s pod {{ $labels.pod }} is in not Ready state on critical infrastructure node {{ $labels.node }} for longer than 20min

    - alert: K8sNodesWithoutOvnNBDBPod
      expr: |
        kube_node_info{node=~"k8s-ovn-0.*"} unless on(node) 
        (kube_pod_info{namespace="ovn-kubernetes", pod=~"ovn-nbdb-.*"}) > 0
      for: 10m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UUPXlpvGk/central-northbound-db
      annotations:
       message: |
         The OVN DB nodes k8s-ovn-01, k8s-ovn-02, and k8s-ovn-03 should be running OVN NB DB Pods,
         but OVN NB DB Pod is not running on {{ $labels.node }} node.

    - alert: K8sNodesWithoutOvnSBDBPod
      expr: |
        kube_node_info{node=~"k8s-ovn-0.*"} unless on(node) 
        (kube_pod_info{namespace="ovn-kubernetes", pod=~"ovn-sbdb-.*"}) > 0
      for: 10m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/sihGi2DGz/central-southbound-db
      annotations:
       message: |
         The OVN DB nodes k8s-ovn-01, k8s-ovn-02, and k8s-ovn-03 should be running OVN NB DB Pods, 
         but OVN SB DB Pod is not running on {{ $labels.node }} node.

    - alert: K8sNodeWithoutOvnNorthPod
      expr: |
        kube_node_info{node=~"ngn-master-.*"} unless on(node) 
        (kube_pod_info{namespace="ovn-kubernetes", pod=~"ovn-north-.*"}) > 0
      for: 10m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/rjQLlpvMk/central-north-daemon
      annotations:
       message: |
         The NGN master nodes ngn-master-01, ngn-master-02, and ngn-master-03 
         should be running ovn-north pods, but ovn-north pod is not running on 
         {{ $labels.node }} node.

    - alert: K8sNodeWithoutOvnKubeManagerPod
      expr: |
        kube_node_info{node=~"ngn-master-.*"} unless on(node) 
        (kube_pod_info{namespace="ovn-kubernetes", pod=~"ovnkube-master-.*"}) > 0
      for: 10m
      labels:
       severity: minor
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         The NGN master nodes ngn-master-01, ngn-master-02, and ngn-master-03 
         should be running ovnkube-manager pod, but ovnkube-manager pod is not 
         running on {{ $labels.node }} node.

    - alert: OvnKubeNodeLogFileSize
      expr: |
        rate(ovnkube_node_logfile_size{namespace="ovn-kubernetes", job="ovnkube-node"}[15m]) * 5 * 60 / 1024 / 1024 > 1
      for: 10m
      labels:
       severity: warning
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/960e_tDMk/k8s-control-panel-kube-agent
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} {{ $labels.logfile_name }} file size is
         increasing {{ printf "%.2f" $value }} Mb / 5 minutes

    - alert: OvnKubeMasterLogFileSize
      expr: |
        rate(ovnkube_controller_logfile_size{namespace="ovn-kubernetes", job="ovnkube-master"}[15m]) * 5 * 60 / 1024 / 1024 > 1
      for: 10m
      labels:
       severity: warning
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} {{ $labels.logfile_name }} file size is
         increasing {{ printf "%.2f" $value }} Mb / 5 minutes

    - alert: OvnKubeManagerStale
      expr: time() - max(ovnkube_controller_nb_e2e_timestamp) > 120
      for: 4m
      labels:
       severity: major
       pduuid: P2AR7UQ
      annotations:
       message: |
         ovn-kubernetes has not written anything to the northbound database for too long

    - alert: OvnNorthdStale
      expr: max(ovnkube_controller_nb_e2e_timestamp) - max(ovnkube_controller_sb_e2e_timestamp) > 120
      for: 4m
      labels:
       severity: critical
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         ovn-northd has not successfully synced changes from northbound DB 
         to the southbound DB for too long

    - alert: OvnNBDBContainerRestarts
      expr: |
        rate(kube_pod_container_status_restarts_total{namespace="ovn-kubernetes", container="nbdb"}[15m]) * 60 * 5 > 0
      for: 30m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UUPXlpvGk/central-northbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} nbdb container is 
         restarting {{ printf "%.2f" $value }} times / 5 minutes

    - alert: OvnNBDBRaftTermChange
      expr: rate(ovn_db_cluster_term{db_name="OVN_Northbound"}[5m]) != 0
      for: 1m
      labels:
        severity: warning
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UUPXlpvGk/central-northbound-db
      annotations:
       message: NBDB RAFT term change detected

    - alert: OvnSBDBContainerRestarts
      expr: |
        rate(kube_pod_container_status_restarts_total{namespace="ovn-kubernetes", container="sbdb"}[15m]) * 60 * 5 > 0
      for: 30m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/sihGi2DGz/central-southbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} sbdb container is 
         restarting {{ printf "%.2f" $value }} times / 5 minutes.

    - alert: OvnSBDBRaftTermChange
      expr: rate(ovn_db_cluster_term{db_name="OVN_Southbound"}[5m]) != 0
      for: 4m
      labels:
        severity: warning
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/sihGi2DGz/central-southbound-db
      annotations:
       message: SBDB RAFT term change detected

    - alert: OvnSBDBMemoryConsumptionUnusuallyHigh
      expr: |
        container_memory_working_set_bytes{job="kubelet", namespace="ovn-kubernetes", pod=~"^ovn-sbdb-.*", container="sbdb"} / 1024 / 1024 / 1024 > 10
      for: 10m
      labels:
        severity: warning
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/sihGi2DGz/central-southbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} OVN_Southbound DB pod memory consumption crossed warning threshold and now at {{ printf "%.2f" $value }} GB

    - alert: OvnSBDBMemoryConsumptionTooHigh
      expr: |
        container_memory_working_set_bytes{job="kubelet", namespace="ovn-kubernetes", pod=~"^ovn-sbdb-.*", container="sbdb"} / 1024 / 1024 / 1024 > 15
      for: 10m
      labels:
        severity: minor
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/sihGi2DGz/central-southbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} OVN_Southbound DB pod memory consumption crossed threshold and now at {{ printf "%.2f" $value }} GB

    - alert: OvnSBDBMemoryConsumptionCriticallyHigh
      expr: |
        container_memory_working_set_bytes{job="kubelet", namespace="ovn-kubernetes", pod=~"^ovn-sbdb-.*", container="sbdb"} / 1024 / 1024 / 1024 > 20
      for: 10m
      labels:
        severity: major
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/sihGi2DGz/central-southbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} OVN_Southbound DB pod memory consumption crossed critical threshold and now at {{ printf "%.2f" $value }} GB

    - alert: OvnSBDBDbSize
      expr: |
        rate(ovn_db_db_size_bytes{namespace="ovn-kubernetes", job="ovnkube-node", db_name="OVN_Southbound"}[15m]) * 5 * 60 / 1024 / 1024 > 40
      for: 10m
      labels:
        severity: warning
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/sihGi2DGz/central-southbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} OVN_Southbound DB size is increasing
         {{ printf "%.2f" $value }} MB / 5 minutes

    - alert: OvnNBDBMemoryConsumptionUnusuallyHigh
      expr: |
        container_memory_working_set_bytes{job="kubelet", namespace="ovn-kubernetes", pod=~"^ovn-nbdb-.*", container="nbdb"} / 1024 / 1024 / 1024 > 5
      for: 10m
      labels:
        severity: warning
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UUPXlpvGk/central-northbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} OVN_Northbound DB pod memory consumption crossed warning threshold and now at {{ printf "%.2f" $value }} GB

    - alert: OvnNBDBMemoryConsumptionTooHigh
      expr: |
        container_memory_working_set_bytes{job="kubelet", namespace="ovn-kubernetes", pod=~"^ovn-nbdb-.*", container="nbdb"} / 1024 / 1024 / 1024 > 7
      for: 10m
      labels:
        severity: minor
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UUPXlpvGk/central-northbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} OVN_Northbound DB pod memory consumption crossed threshold and now at {{ printf "%.2f" $value }} GB

    - alert: OvnNBDBMemoryConsumptionCriticallyHigh
      expr: |
        container_memory_working_set_bytes{job="kubelet", namespace="ovn-kubernetes", pod=~"^ovn-nbdb-.*", container="nbdb"} / 1024 / 1024 / 1024 > 10
      for: 10m
      labels:
        severity: major
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UUPXlpvGk/central-northbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} OVN_Northbound DB pod memory consumption crossed critical threshold and now at {{ printf "%.2f" $value }} GB

    - alert: OvnNBDBDbSize
      expr: |
        rate(ovn_db_db_size_bytes{namespace="ovn-kubernetes", job="ovnkube-node", db_name="OVN_Northbound"}[15m]) * 5 * 60 / 1024 / 1024 > 20
      for: 10m
      labels:
        severity: warning
        pduuid: P2AR7UQ
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UUPXlpvGk/central-northbound-db
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} OVN_Northbound DB size is increasing
         {{ printf "%.2f" $value }} MB / 5 minutes

    - alert: OvnNorthdContainerRestarts
      expr: |
        rate(kube_pod_container_status_restarts_total{namespace="ovn-kubernetes", container="ovn-northd"}[15m]) * 60 * 5 > 0
      for: 30m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/rjQLlpvMk/central-north-daemon
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovn-northd container is 
         restarting {{ printf "%.2f" $value }} times / 5 minutes

    - alert: OvnNorthdTxnError
      expr: |
        rate(ovn_northd_txn_error{namespace="ovn-kubernetes",job="ovnkube-node"}[1m]) > 0
      for: 10m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/rjQLlpvMk/central-north-daemon
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovn-northd containers
         transaction error is {{ printf "%.2f" $value }} per second

    - alert: OvnNorthdTxnIncomplete
      expr: |
        rate(ovn_northd_txn_incomplete{namespace="ovn-kubernetes",job="ovnkube-node"}[1m]) > 1
      for: 30m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/rjQLlpvMk/central-north-daemon
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovn-northd containers
         transaction incomplete is {{ printf "%.2f" $value }} per second.

    - alert: OvnControllerContainerRestarts
      expr: |
        rate(kube_pod_container_status_restarts_total{namespace="ovn-kubernetes", 
        container="ovn-controller"}[15m]) * 60 * 5 > 0
      for: 30m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/9dlp8fSGk/host-controller
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovn-controller container 
         is restarting {{ printf "%.2f" $value }} times / 5 minutes

    - alert: OvnControllerTxnError
      expr: |
        rate(ovn_controller_txn_error{namespace="ovn-kubernetes",job="ovnkube-node"}[1m]) > 0
      for: 10m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/9dlp8fSGk/host-controller
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovn-controller containers
         transaction error is {{ printf "%.2f" $value }} per second.

    - alert: OvnControllerTxnIncomplete
      expr: |
        rate(ovn_controller_txn_incomplete{namespace="ovn-kubernetes",job="ovnkube-node"}[1m]) > 1
      for: 30m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/9dlp8fSGk/host-controller
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovn-controller containers
         transaction incomplete is {{ printf "%.2f" $value }} per second

    - alert: OvnControllerLflowRun
      expr: |
        rate(ovn_controller_lflow_run{namespace="ovn-kubernetes",job="ovnkube-node"}[1m]) > 0
      for: 10m
      labels:
       severity: warning
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/9dlp8fSGk/host-controller
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovn-controller containers
         logical flow table translation is {{ printf "%.2f" $value }} per second.
       
    - alert: OvnVaultAgentContainerRestarts
      expr: |
        rate(kube_pod_container_status_restarts_total{namespace="ovn-kubernetes",
        container="vault-agent"}[15m]) * 60 * 5 > 0
      for: 30m
      labels:
        severity: major
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} vault-agent container
         is restarting {{ printf "%.2f" $value }} times / 5 minutes

    - alert: OvsVfRepInterfaceDown
      expr: |
        ovs_vswitchd_interface_link_state{interface=~"pf.*", port!=""} != 2
      for: 10m
      labels:
       severity: major
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Interface {{ $labels.interface }} on instance {{ $labels.instance }} is not up for longer than 10m

    - alert: OvsTxNoOffloadBytesCriticallyHigh
      expr: |
        rate(ovs_vswitchd_interface_tx_sw_bytes{interface=~"pf.*"}[15m]) / 1024 / 1024 > 60
      for: 10m
      labels:
       severity: critical
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 60MiB/s TX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 10m

    - alert: OvsTxNoOffloadBytesTooHigh
      expr: |
        rate(ovs_vswitchd_interface_tx_sw_bytes{interface=~"pf.*"}[10m]) / 1024 / 1024 > 40
      for: 5m
      labels:
       severity: minor
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 40MiB/s TX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 5m

    - alert: OvsTxNoOffloadBytesUnusuallyHigh
      expr: |
        rate(ovs_vswitchd_interface_tx_sw_bytes{interface=~"pf.*"}[5m]) / 1024 / 1024 > 20
      for: 5m
      labels:
       severity: warning
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 20MiB/s TX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 5m

    - alert: OvsRxNoOffloadBytesCriticallyHigh
      expr: |
        rate(ovs_vswitchd_interface_rx_sw_bytes{interface=~"pf.*"}[15m]) / 1024 / 1024 > 60
      for: 10m
      labels:
       severity: critical
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 60MiB/s RX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 10m

    - alert: OvsRxNoOffloadBytesTooHigh
      expr: |
        rate(ovs_vswitchd_interface_rx_sw_bytes{interface=~"pf.*"}[10m]) / 1024 / 1024 > 40
      for: 5m
      labels:
       severity: minor
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 40MiB/s RX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 5m

    - alert: OvsRxNoOffloadBytesUnusuallyHigh
      expr: |
        rate(ovs_vswitchd_interface_rx_sw_bytes{interface=~"pf.*"}[5m]) / 1024 / 1024 > 20
      for: 5m
      labels:
       severity: warning
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 20MiB/s RX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 5m

    - alert: OvsMegaFlowsTotalUnusuallyHigh
      expr: |
        (ovs_vswitchd_dp_offloaded_flows_total + ovs_vswitchd_dp_flows_total) > 10000
      for: 5m
      labels:
       severity: warning
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed unusually high number {{ $value }} of fast-path flows on the host with
         pod ovn-kubernetes/ {{ $labels.pod }} instance {{ $labels.instance }} for longer than 5m

    - alert: OvsTxRateLimitDropsUnusuallyHigh
      expr: |
        rate(ovs_vswitchd_interface_tx_misspkts_packets_drops[5m]) > 40
      for: 5m
      labels:
       severity: warning
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed TX rate limit caused {{ $value }} packet per second drops on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 5m

    - alert: OvsDBdbSize
      expr: |
        rate(ovs_ovsdb_db_size_bytes{namespace="ovn-kubernetes", job="ovnkube-node"}[15m]) * 5 * 60 / 1024 / 1024 > 1
      for: 10m
      labels:
       severity: warning
       pduuid: P2AR7UQ
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
