---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ovn-node-dpu-host
  namespace: ovn-kubernetes

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ovn-node-dpu-host
roleRef:
  name: ovn-node-dpu-host
  kind: ClusterRole
  apiGroup: rbac.authorization.k8s.io
subjects:
- kind: ServiceAccount
  name: ovn-node-dpu-host
  namespace: ovn-kubernetes

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  namespace: {{ .Values.global.namespace }}
  name: ovn-node-dpu-host-specific-rolebindings
roleRef:
  name: ovn-node-dpu-host-specific-roles
  kind: Role
  apiGroup: rbac.authorization.k8s.io
subjects:
  - kind: ServiceAccount
    namespace: {{ .Values.global.namespace }}
    name: ovn-node-dpu-host

---
# RBAC policies for ovnk8s-node-dpu-host
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: ovn-node-dpu-host
rules:
- apiGroups:
  - ""
  resources:
  - pods
  verbs: ["get", "list", "watch", "update"]
- apiGroups:
  - ""
  resources:
  - nodes
  - services
  - namespaces
  verbs: ["get", "list", "watch"]
- apiGroups:
  - discovery.k8s.io
  resources:
  - endpointslices
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources: ["events"]
  verbs: ["create", "patch", "update"]
- apiGroups:
  - k8s.ovn.org
  resources:
  - egressips
  verbs: ["get", "list", "watch"]
- apiGroups: ["k8s.ovn.org"]
  resources:
    - egressservices
    - adminpolicybasedexternalroutes
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources:
      - nodes/status
      - pods/status
  verbs: [ "patch", "update" ]
- apiGroups:
  - k8s.cni.cncf.io
  resources:
  - network-attachment-definitions
  verbs: ["get", "list", "watch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: {{ .Values.global.namespace }}
  name: ovn-node-dpu-host-specific-roles
rules:
  # moved from only-ovnk8s-configmaps RoleBinding
  - apiGroups: [""]
    resources:
      - configmaps
    verbs: ["get", "list", "watch"]
  # moved from only-ovnk8s-endpoints RoleBinding
  - apiGroups: [""]
    resources:
      - endpoints
    verbs: ["get"]
