apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  labels:
    prometheus: k8s
    shardable: "true"
    role: alert-rules
  name: ovnkube-rules-shardable-cx
  namespace: ovn-kubernetes
spec:
  groups:
  - name: general.rules
    rules:
    - alert: OvsVfRepInterfaceDown
      expr: |
        ovs_vswitchd_interface_link_state{interface=~"^enp.*_[0-9]+", port!=""} != 2 and ovs_vswitchd_interface_of_port{interface=~"^enp.*_[0-9]+"} != -1
      for: 10m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Interface {{ $labels.interface }} on instance {{ $labels.instance }} is not up for longer than 10m

    - alert: OvsTxNoOffloadBytesCriticallyHigh
      expr: |
        rate(ovs_vswitchd_interface_tx_sw_bytes{interface=~"^enp.*_[0-9]+"}[15m]) / 1024 / 1024 > 60
      for: 10m
      labels:
       severity: critical
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 60MiB/s TX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 10m

    - alert: OvsTxNoOffloadBytesTooHigh
      expr: |
        rate(ovs_vswitchd_interface_tx_sw_bytes{interface=~"^enp.*_[0-9]+"}[10m]) / 1024 / 1024 > 40
      for: 5m
      labels:
       severity: minor
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 40MiB/s TX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 5m

    - alert: OvsTxNoOffloadBytesUnusuallyHigh
      expr: |
        rate(ovs_vswitchd_interface_tx_sw_bytes{interface=~"^enp.*_[0-9]+"}[5m]) / 1024 / 1024 > 20
      for: 5m
      labels:
       severity: warning
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 20MiB/s TX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 5m

    - alert: OvsRxNoOffloadBytesCriticallyHigh
      expr: |
        rate(ovs_vswitchd_interface_rx_sw_bytes{interface=~"^enp.*_[0-9]+"}[15m]) / 1024 / 1024 > 60
      for: 10m
      labels:
       severity: critical
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 60MiB/s RX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 10m

    - alert: OvsRxNoOffloadBytesTooHigh
      expr: |
        rate(ovs_vswitchd_interface_rx_sw_bytes{interface=~"^enp.*_[0-9]+"}[10m]) / 1024 / 1024 > 40
      for: 5m
      labels:
       severity: minor
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 40MiB/s RX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 5m

    - alert: OvsRxNoOffloadBytesUnusuallyHigh
      expr: |
        rate(ovs_vswitchd_interface_rx_sw_bytes{interface=~"^enp.*_[0-9]+"}[5m]) / 1024 / 1024 > 20
      for: 5m
      labels:
       severity: warning
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Noticed higher than 20MiB/s RX rates without offload on the host with pod ovn-kubernetes/ {{ $labels.pod }}
         instance {{ $labels.instance }} port {{ $labels.port }} interface {{ $labels.interface }} for longer than 5m

    - alert: OvsVswitchdVtepInterfaceMtu
      expr: |
        ovs_vswitchd_interface_mtu and
        (ovs_vswitchd_interface_mtu{namespace="ovn-kubernetes",job="ovnkube-node",interface=~"^vtep.*"} != 8170)
      for: 10m
      labels:
       severity: warning
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovs-vswitchd process reports that
         vtep interface MTU value is {{ $value }}

    - alert: IncorrectMTUOnHostUplink
      expr: |
        ovs_vswitchd_interface_mtu and
        (ovs_vswitchd_interface_mtu{namespace="ovn-kubernetes",job="ovnkube-node",interface=~"^enp.*s0f[0|1]$"} != 8170)
      for: 10m
      labels:
       severity: warning
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovs-vswitchd process reports that
         uplink interface {{ $labels.interface }} has MTU {{ $value }} while 8170 is expected

    - alert: IncorrectMTUOnHostBond
      expr: |
        ovs_vswitchd_interface_mtu and
        (ovs_vswitchd_interface_mtu{namespace="ovn-kubernetes",job="ovnkube-node",interface=~"^bond[0|1]$"} != 8170)
      for: 10m
      labels:
       severity: warning
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Pod ovn-kubernetes/ {{ $labels.pod }} ovs-vswitchd process reports that
         bond interface {{ $labels.interface }} has MTU {{ $value }} while 8170 is expected
