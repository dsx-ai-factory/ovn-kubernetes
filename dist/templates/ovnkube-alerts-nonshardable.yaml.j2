apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  labels:
    prometheus: k8s
    shardable: "false"
    role: alert-rules
  name: ovnkube-rules-nonshardable
  namespace: ovn-kubernetes
spec:
  groups:
  - name: general.rules
    rules:
    - alert: OvnKubeNoRunningManager
      expr: absent(up{job="ovnkube-master", namespace="ovn-kubernetes"} == 1)
      for: 4m
      labels:
       severity: critical
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: There is no running ovnkube-manager

    - alert: OvnKubeManagerMultipleLeaders
      expr: sum(ovnkube_controller_leader) > 1
      for: 4m
      labels:
       severity: critical
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: There are multiple ovnkube-manager leaders

    - alert: OvnKubeManagerNoLeader
      expr: max(ovnkube_controller_leader) == 0
      for: 4m
      labels:
        severity: critical
        pduuid: P10A23N
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: There is no running ovnkube-manager leader

    - alert: OvnKubeHighPodCreationLatency99thPercentile
      expr: |
        histogram_quantile(0.99,
         sum by (le) (
           rate(ovnkube_controller_pod_creation_latency_seconds_bucket[2m])
         ) 
        ) > 20
      for: 30m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         The pod creation latency value {{ $value }} aggregated across 
         all masters for the last 30 minutes is more than 20 seconds.

    - alert: OvnKubeIncreaseInPodCreationLatency99thPercentile
      expr: |
        histogram_quantile(0.99,
         sum by (le) ( 
          rate(ovnkube_controller_pod_creation_latency_seconds_bucket[2m] 
          offset 15m)
         )
        )
        -
        histogram_quantile(0.99,
         sum by (le) (
          rate(ovnkube_controller_pod_creation_latency_seconds_bucket[2m])
         )
        ) > 20 
      for: 30m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         The pod creation latency aggregated across all masters for the last 
         30 minutes is more than 20 seconds as compared to 15 minutes before last 2 minutes.

    - alert: OvnKubeHighK8sNetworkPolicyUpdateLatency99thPercentile
      expr: |
        histogram_quantile(0.99,
          sum by (le) (
            rate(ovnkube_controller_resource_update_latency_seconds_bucket{
              name="NetworkPolicy"}[15m])
          )
        ) > 1
      for: 10m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         The 99th percentile {{ $labels.name }} update latency {{ $value }} aggregated 
         across all masters for the last 15minutes is more than 1 seconds.

    - alert: OvnKubeHighK8sNamespaceUpdateLatency99thPercentile
      expr: |
        histogram_quantile(0.99,
          sum by (le) (
            rate(ovnkube_controller_resource_update_latency_seconds_bucket{
              name="Namespace"}[15m])
          )
        ) > 1
      for: 10m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         The 99th percentile {{ $labels.name }} update latency {{ $value }} 
         aggregated across all masters for the last 15minutes is more than 1 seconds.

    - alert: OvnKubeHighK8sServiceUpdateLatency99thPercentile
      expr: |
        histogram_quantile(0.99,
          sum by (le) (
            rate(ovnkube_controller_resource_update_latency_seconds_bucket{
              name="Service"}[15m])
          )
        ) > 1
      for: 10m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         The 99th percentile {{ $labels.name }} update latency {{ $value }} aggregated 
         across all masters for the last 15minutes is more than 1 seconds.

    - alert: OvnKubeHighK8sEndpointUpdateLatency99thPercentile
      expr: |
        histogram_quantile(0.99,
          sum by (le) (
            rate(ovnkube_controller_resource_update_latency_seconds_bucket{
              name="Endpoint"}[15m])
          )
        ) > 1
      for: 10m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         The 99th percentile {{ $labels.name }} update latency {{ $value }} aggregated
         across all masters for the last 15minutes is more than 1 seconds.

    - alert: OvnNBDBMultipleLeaders
      expr: sum(ovn_db_cluster_server_role{db_name="OVN_Northbound",server_role="leader"}) > 1
      for: 4m
      labels:
       severity: critical
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UUPXlpvGk/central-northbound-db
      annotations:
       message: There are multiple ovn-nbdb leaders

    - alert: OvnNBDBNoLeader
      expr: max(ovn_db_cluster_server_role{db_name="OVN_Northbound",server_role="leader"}) == 0
      for: 4m
      labels:
        severity: critical
        pduuid: P10A23N
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UUPXlpvGk/central-northbound-db
      annotations:
       message: There is no running ovn-nbdb leader

    - alert: OvnSBDBMultipleLeaders
      expr: sum(ovn_db_cluster_server_role{db_name="OVN_Southbound",server_role="leader"}) > 1
      for: 4m
      labels:
       severity: critical
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/sihGi2DGz/central-southbound-db
      annotations:
       message: There are multiple ovn-sbdb leaders

    - alert: OvnSBDBNoLeader
      expr: max(ovn_db_cluster_server_role{db_name="OVN_Southbound",server_role="leader"}) == 0
      for: 4m
      labels:
        severity: critical
        pduuid: P10A23N
        dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/sihGi2DGz/central-southbound-db
      annotations:
       message: There is no running ovn-sbdb leader

    - alert: OvnNorthdNotActive
      expr: sum(ovn_northd_status) != 1
      for: 4m
      labels:
       severity: critical
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/rjQLlpvMk/central-north-daemon
      annotations:
       message: There is no running ovn-northd.

    - alert: OvnControllerLowerGenevePortCount
      expr: |
        ovn_controller_integration_bridge_geneve_ports_total and kube_node_info and
        (ovn_controller_integration_bridge_geneve_ports_total{job="ovnkube-node", namespace="ovn-kubernetes"} 
        != scalar(count(kube_node_info)) - 1)
      for: 10m
      labels:
       severity: warning
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/9dlp8fSGk/host-controller
      annotations:
       message: |
         The list of nodes that have a lower number of Geneve Ports
         and counts they have 
         {{ range query "ovn_controller_integration_bridge_geneve_ports_total{job='ovnkube-node', namespace='ovn-kubernetes'} !=  scalar(count(kube_node_info)) - 1" }}
         {{ .Labels.instance }}: {{ .Value }}
         {{ end }}.

    - alert: OVNKubeAllocatedSubnetsDoNotMatch
      expr: |
        ovnkube_master_allocated_v4_host_subnets{job="ovnkube-master", namespace="ovn-kubernetes"} !=
        scalar(sum(kube_node_info) - sum(kube_node_info{node=~".*-dpu.*"} OR on() vector(0)))
      for: 10m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/PHqwgBHMz/k8s-control-panel-kube-manager
      annotations:
       message: |
         ovnkubeMaster allocated IPv4 host subnets value for {{ $labels.network_name }} network should be same as the number of K8s nodes excluding the DPU nodes

    - alert: NoCarrierOnUplinkInterface
      expr: |
        label_replace(node_network_carrier{device=~"^enp.*s0f[0|1]$|^p[0|1]$|^pf[0|1]hpf$|^bond[0|1]$",job=~"node-exporter|node-exporter-dpu"} != 1, "node", "$0", "instance", ".*") *
            on (node) group_left kube_node_spec_unschedulable == 0
      for: 4m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Carrier was not detected on uplink interface {{ $labels.device }} in instance {{ $labels.instance }}.

    - alert: NoCarrierOnAdminServerUplinkInterface
      expr: |
        node_network_carrier{device=~"^enp.*s0f[0|1]$",job="admin-host-metrics"} != 1
      for: 4m
      labels:
       severity: major
       pduuid: P10A23N
       dashboard: https://ngn-grafana.thanos.nvidiangn.net/d/UVSzupDGz/host-ovs
      annotations:
       message: |
         Carrier was not detected on uplink interface {{ $labels.device }} in instance {{ $labels.instance }}.
