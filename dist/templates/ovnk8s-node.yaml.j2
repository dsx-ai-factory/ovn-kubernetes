---
# {{ ovnkube_app_name }}
# daemonset version 3
# starts onvkube node daemon in a container
# it is run on all nodes
kind: DaemonSet
apiVersion: apps/v1
metadata:
  name: {{ ovnkube_app_name }}
  # namespace set up by install
  namespace: ovn-kubernetes
  annotations:
    kubernetes.io/description: |
      This DaemonSet launches the ovn-kubernetes networking components for worker nodes.
spec:
  selector:
    matchLabels:
      app: {{ ovnkube_app_name }}
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 25%
  template:
    metadata:
      labels:
        app: {{ ovnkube_app_name }}
        name: {{ ovnkube_app_name }}
        component: network
        type: infra
        kubernetes.io/os: "linux"
        metrics: ovnkube-node
    spec:
      imagePullSecrets:
        - name: ovncni-nvcr-ips
      {%- if ovnkube_app_name=="ovnkube-node" %}
      serviceAccountName: ovn-node
      {%- elif ovnkube_app_name=="ovnkube-node-dpu-host" %}
      serviceAccountName: ovn-node-dpu-host
      {%- endif %}
      hostNetwork: true
      dnsPolicy: Default
      priorityClassName: "system-node-critical"
      {{ "hostPID: true" if ovn_unprivileged_mode=="no" }}
      containers:
        - name: ovnkube-node
          image: "{{ ovn_image | default('docker.io/ovnkube/ovn-daemonset:latest') }}"
          imagePullPolicy: "{{ ovn_image_pull_policy | default('IfNotPresent') }}"
          {% if ovn_dummy_gateway_bridge=="true" %}
          lifecycle:
            postStart:
              exec:
                command:
                - /bin/bash
                - -c
                - |
                  #!/bin/bash
                  ovs-vsctl --may-exist add-br br-ex
                  ip a a dev br-ex 10.44.0.1/32 || /bin/true
          {% endif %}

          command: ["/root/ovnkube.sh", "ovn-node"]
          # ovnkube-node-liveness-check.sh checks
          # - 10-ovn-kubernetes.conf is present
          # - ovn-cni-server.sock is serving cni requests
          livenessProbe:
            exec:
              command:
                - /bin/bash
                - /root/ovnkube-node-liveness-check.sh
            failureThreshold: 3
            initialDelaySeconds: 30
            periodSeconds: 30
            successThreshold: 1
            timeoutSeconds: 5
          # ovnkube-node-readiness-check.sh checks
          # - whether the metrics server is running since it is one of the last things we do,
          # - also checks if we can access KUBERNETES_SERVICE_HOST:KUBERNETES_SERVICE_PORT
          # - also checks if we can access coredns service
          readinessProbe:
            exec:
              command:
              - /bin/bash
              - /root/ovnkube-node-readiness-check.sh
            initialDelaySeconds: 30
            timeoutSeconds: 5
            periodSeconds: 30
            
          securityContext:
            runAsUser: 0
            {% if ovn_unprivileged_mode=="no" -%}
            privileged: true
            {% else -%}
            capabilities:
              add:
              - NET_ADMIN
            {% endif %}

          terminationMessagePolicy: FallbackToLogsOnError
          volumeMounts:
            # Common mounts
            # for the iptables wrapper
            - mountPath: /host
              name: host-slash
              readOnly: true
            - mountPath: /var/run/dbus/
              name: host-var-run-dbus
              readOnly: true
            - mountPath: /var/log/ovn-kubernetes/
              name: host-var-log-ovnkube
              # We mount our socket here
            - mountPath: /var/run/ovn-kubernetes
              name: host-var-run-ovn-kubernetes
            # CNI related mounts which we take over
            - mountPath: /opt/cni/bin
              name: host-opt-cni-bin
            - mountPath: /etc/cni/net.d
              name: host-etc-cni-netd
            - mountPath: /ovn-cert
              name: ovn-pki
              readOnly: true
            {% if kind is defined and kind -%}
            - mountPath: /var/run/netns
              name: host-netns
              mountPropagation: Bidirectional
            {% endif %}
            {%- if ovnkube_app_name=="ovnkube-node" %}
            # ovnkube-node only mounts (non dpu related)
            - mountPath: /var/run/openvswitch/
              name: host-var-run-ovs
            - mountPath: /var/run/ovn/
              name: host-var-run-ovs
            # for ovn-db metrics
            - mountPath: /etc/openvswitch/
              name: host-var-lib-ovs
              readOnly: true
            - mountPath: /etc/ovn/
              name: host-var-lib-ovs
              readOnly: true
            {%- elif ovnkube_app_name=="ovnkube-node-dpu-host" %}
            # ovnkube-node dpu-host mounts
            - mountPath: /var/run/ovn
              name: var-run-ovn
            {%- endif %}

          resources:
            requests:
              cpu: 100m
              memory: 300Mi
          env:
            - name: OVN_DAEMONSET_VERSION
              value: "3"
            - name: OVNKUBE_LOGLEVEL
              value: "{{ ovnkube_node_loglevel }}"
            - name: OVNKUBE_LOGFILE_MAXSIZE
              value: "{{ ovnkube_logfile_maxsize }}"
            - name: OVNKUBE_LOGFILE_MAXBACKUPS
              value: "{{ ovnkube_logfile_maxbackups }}"
            - name: OVNKUBE_LOGFILE_MAXAGE
              value: "{{ ovnkube_logfile_maxage }}"
            - name: OVNKUBE_LOGFILE
              value: "{{ ovnkube_logfile }}"
            - name: OVN_METRICS_SCRAPE_INTERVAL
              value: "{{ ovn_metrics_scrape_interval }}"
            - name: OVN_NET_CIDR
              valueFrom:
                configMapKeyRef:
                  name: ovn-config
                  key: net_cidr
            - name: OVN_SVC_CIDR
              valueFrom:
                configMapKeyRef:
                  name: ovn-config
                  key: svc_cidr
            - name: K8S_APISERVER
              valueFrom:
                configMapKeyRef:
                  name: ovn-config
                  key: k8s_apiserver
            - name: OVN_MTU
              valueFrom:
                configMapKeyRef:
                  name: ovn-config
                  key: mtu
            - name: OVN_ROUTABLE_MTU
              valueFrom:
                configMapKeyRef:
                  name: ovn-config
                  key: routable_mtu
                  optional: true
            - name: K8S_NODE
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: K8S_NODE_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.hostIP
            - name: OVN_GATEWAY_MODE
              value: "{{ ovn_gateway_mode }}"
            - name: OVN_GATEWAY_OPTS
              value: "{{ ovn_gateway_opts }}"
            - name: OVN_ADMIN_NETWORK_POLICY_ENABLE
              value: "{{ ovn_admin_network_policy_enable }}"
            - name: OVN_HYBRID_OVERLAY_NET_CIDR
              value: "{{ ovn_hybrid_overlay_net_cidr }}"
            - name: OVN_EGRESSIP_ENABLE
              value: "{{ ovn_egress_ip_enable }}"
            - name: OVN_EGRESSIP_HEALTHCHECK_PORT
              value: "{{ ovn_egress_ip_healthcheck_port }}"
            - name: OVN_EGRESSSERVICE_ENABLE
              value: "{{ ovn_egress_service_enable }}"
            - name: OVN_HYBRID_OVERLAY_ENABLE
              value: "{{ ovn_hybrid_overlay_enable }}"
            - name: OVN_DISABLE_SNAT_MULTIPLE_GWS
              value: "{{ ovn_disable_snat_multiple_gws }}"
            - name: OVN_DISABLE_FORWARDING
              value: "{{ ovn_disable_forwarding }}"
            - name: OVN_ENCAP_PORT
              value: "{{ ovn_encap_port }}"
            - name: OVN_DISABLE_PKT_MTU_CHECK
              value: "{{ ovn_disable_pkt_mtu_check }}"
            - name: OVN_NETFLOW_TARGETS
              value: "{{ ovn_netflow_targets }}"
            - name: OVN_SFLOW_TARGETS
              value: "{{ ovn_sflow_targets }}"
            - name: OVN_IPFIX_TARGETS
              value: "{{ ovn_ipfix_targets }}"
            - name: OVN_IPFIX_SAMPLING
              value: "{{ ovn_ipfix_sampling }}"
            - name: OVN_IPFIX_CACHE_MAX_FLOWS
              value: "{{ ovn_ipfix_cache_max_flows }}"
            - name: OVN_IPFIX_CACHE_ACTIVE_TIMEOUT
              value: "{{ ovn_ipfix_cache_active_timeout }}"
            - name: OVN_V4_MASQUERADE_SUBNET
              value: "{{ ovn_v4_masquerade_subnet }}"
            - name: OVN_V6_MASQUERADE_SUBNET
              value: "{{ ovn_v6_masquerade_subnet }}"
            - name: OVN_MULTICAST_ENABLE
              value: "{{ ovn_multicast_enable }}"
            - name: OVN_UNPRIVILEGED_MODE
              value: "{{ ovn_unprivileged_mode | default('yes') }}"
            - name: OVN_EX_GW_NETWORK_INTERFACE
              value: "{{ ovn_ex_gw_networking_interface }}"
            - name: COREDNS_CLUSTER_IP
              value: "{{ coredns_cluster_ip }}"
            - name: OVN_ENABLE_OVNKUBE_IDENTITY
              value: "{{ ovn_enable_ovnkube_identity }}"
            - name: OVN_MULTI_NETWORK_ENABLE
              value: "{{ ovn_multi_network_enable }}"
            - name: OVN_NORTHD_NODE_SELECTOR_LABEL
              value: "{{ ovn_northd_node_selector_label }}"
            {% if ovnkube_app_name=="ovnkube-node" -%}
            - name: OVNKUBE_DISABLE_OVS_METRICS
              value: "{{ disable_ovs_metrics }}"            
            - name: OVN_NB_CERT_CNAME
              value: "{{ ovn_nb_cert_cname }}"
            - name: OVN_SB_CERT_CNAME
              value: "{{ ovn_sb_cert_cname }}"
            - name: OVN_DISABLE_OVN_IFACE_ID_VER
              value: "{{ ovn_disable_ovn_iface_id_ver }}"
            - name: OVN_OFCTRL_WAIT_BEFORE_CLEAR
              value: "{{ ovn_ofctrl_wait_before_clear }}"
            - name: OVN_MONITOR_ALL
              value: "{{ ovn_monitor_all }}"
            - name: OVN_ENABLE_LFLOW_CACHE
              value: "{{ ovn_enable_lflow_cache }}"
            - name: OVN_LFLOW_CACHE_LIMIT
              value: "{{ ovn_lflow_cache_limit }}"
            - name: OVN_LFLOW_CACHE_LIMIT_KB
              value: "{{ ovn_lflow_cache_limit_kb }}"
            - name: OVN_ENABLE_INTERCONNECT
              value: "{{ ovn_enable_interconnect }}"
            - name: OVN_ENABLE_MULTI_EXTERNAL_GATEWAY
              value: "{{ ovn_enable_multi_external_gateway }}"
            - name: OVN_REMOTE_PROBE_INTERVAL
              value: "{{ ovn_remote_probe_interval }}"
            - name: OVNKUBE_NODE_MGMT_PORT_NETDEV
              value: ""
            {% endif -%}
            {% if ovnkube_app_name=="ovnkube-node-dpu-host" -%}
            - name: OVNKUBE_NODE_MODE
              value: "dpu-host"
            - name: OVNKUBE_NODE_MGMT_PORT_NETDEV
              value: "{{ ovnkube_node_mgmt_port_netdev }}"
            {% endif -%}
            - name: OVN_HOST_NETWORK_NAMESPACE
              valueFrom:
                configMapKeyRef:
                  name: ovn-config
                  key: host_network_namespace
            - name: POD_NAME
              valueFrom:
               fieldRef:
                 apiVersion: v1
                 fieldPath: metadata.name

        # end of container

      {% if ovnkube_app_name=="ovnkube-node-dpu-host" -%}
      nodeSelector:
        kubernetes.io/arch: amd64
        k8s.ovn.org/dpu-host: ""
      {% else -%}
      nodeSelector:
        kubernetes.io/arch: amd64
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: k8s.ovn.org/dpu-host
                operator: DoesNotExist
      {% endif -%}
      volumes:
        # Common volumes
        - name: host-var-run-dbus
          hostPath:
            path: /var/run/dbus
        - name: host-var-log-ovnkube
          hostPath:
            path: /var/log/ovn-kubernetes
        - name: host-var-run-ovn-kubernetes
          hostPath:
            path: /var/run/ovn-kubernetes
        - name: host-opt-cni-bin
          hostPath:
            path: /opt/cni/bin
        - name: host-etc-cni-netd
          hostPath:
            path: /etc/cni/net.d
        - name: ovn-pki
          hostPath:
            path: /etc/ovn
            type: DirectoryOrCreate
        - name: host-slash
          hostPath:
            path: /
        {% if kind is defined and kind -%}
        - name: host-netns
          hostPath:
            path: /var/run/netns
        {% endif %}
        {%- if ovnkube_app_name=="ovnkube-node" %}
        # non DPU related volumes
        - name: host-var-run-ovs
          hostPath:
            path: /var/run/openvswitch
        - name: host-var-lib-ovs
          hostPath:
            path: /var/lib/openvswitch
        {%- elif ovnkube_app_name=="ovnkube-node-dpu-host" %}
        - name: var-run-ovn
          emptyDir: {}
        {%- endif %}

      tolerations:
        - operator: "Exists"
